# docker compose 的变量文件：cp .env.example .env 后按部署机填写。.env 已 gitignore。

# ---- 镜像 ----
# 在部署机本地 build 用这个名字；如果以后走 registry，改成 registry 地址再 docker compose pull
IMAGE=sim-dji-cloud:local

# ---- 容器运行身份：必须等于宿主机 recordings/ logs/ 目录属主（id -u / id -g）----
PUID=1000
PGID=1000

# ---- 时区：飞行目录名 <dock_sn>_<YYYYMMDD-HHMMSS> 用本地时间，要跟现有目录保持一致 ----
TZ=Asia/Shanghai

# ---- 宿主机数据目录（相对 docker-compose.yml 所在目录；默认就是项目里现有的目录）----
RECORDINGS_DIR=./recordings
RECORDINGS_PILOT_DIR=./recordings_pilot
LOGS_DIR=./logs
# 配置文件所在目录（只读挂到容器 /config）；默认项目目录，里面的任意 yaml 都能按文件名指定
CONFIG_DIR=.
# `docker compose up -d` 默认用的配置文件名（相对 CONFIG_DIR）
# 一次性换别的配置不用改这里：docker compose run --rm record recorder_125.yaml
RECORDER_CONFIG=recorder.yaml
PILOT_CONFIG=pilot_recorder.yaml

# ---- DJI 云 MQTT 凭据：仅当 yaml 里写的是 ${env:DJI_MQTT_USERNAME} 这种引用时才需要填；
#      凭据明文写在 yaml 里则留空 ----
DJI_MQTT_USERNAME=
DJI_MQTT_PASSWORD=

# ---- dashboard ----
DASH_PORT=8080
# dashboard / play 连的本地 broker（network_mode: host，所以 127.0.0.1 就是宿主机）
MQTT_URL=tcp://127.0.0.1:1883
# WS 推送间隔 ms；OSD 源头 2s/帧，run.sh 里用 200 让轨迹更跟手
DASH_WS_INTERVAL=2000
# SRS HTTP-FLV 地址；留空则 dashboard 不带视频面板
VIDEO_URL=
# dashboard 切飞行时默认带的视频推流 URL；留空则切飞行只回放数据
DEFAULT_VIDEO_PUSH_URL=
# HTTP 控制 play 的 token（openssl rand -hex 16）；留空 = POST 端点返 503，只读 dashboard 正常
DASHBOARD_TOKEN=
# 飞行区域叠加：文件放 deploy/area/，这里写容器内路径 /area/<文件名>；留空不叠加
FLIGHT_AREA_XML=
FLIGHT_AREA_PNG=
FLIGHT_AREA_BOUNDS_LATLON=
# 额外透传给 sim-dji dashboard 的参数（一般留空）
DASH_EXTRA_ARGS=
