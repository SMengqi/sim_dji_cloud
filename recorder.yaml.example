mqtt:
  host: dji-cloud.example.com
  port: 8883
  tls: true
  client_id: sim-dji-recorder-001
  dock_sn: "SN_DOCK_EXAMPLE"
  username: "${env:DJI_MQTT_USERNAME}"
  password: "${env:DJI_MQTT_PASSWORD}"
  ca_file: null
  cert_file: null
  key_file: null
  subscribe_patterns:
    - "thing/product/+/+"
    - "thing/product/+/property/+"
    - "thing/product/+/drc/+"
    - "sys/product/+/+"
  deny_topics:
    - exact: "thing/product/SN_DOCK_EXAMPLE/firmware_upgrade"
    - regex: "thing/product/.+/token.*"

storage:
  root: ./recordings
  enable_raw_firehose: false
  flush_max_records: 1000
  flush_interval_ms: 200
  queue_max_size: 10000
  rotate_max_bytes: 104857600
  rotate_max_records: 1000000

video:
  enabled: false                 # 默认不录视频；需要时启动加 --video
  source_url_override: "rtmp://localhost/live/dock"
  source_url_field: "osd.live_capacity.live_status[0].rtmp_url"
  ffmpeg_extra_args: []

flight_detection:
  record_steps: [0, 1, 2]        # dock flighttask_step_code ∈ 此集合时录制（0准备/1飞行/2作业后恢复）
  idle_debounce_seconds: 5       # 进入空闲(5)等持续该秒数后收尾当前任务
