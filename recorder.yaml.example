mqtt:
  host: dji-cloud.example.com
  port: 8883
  tls: true
  client_id: sim-dji-recorder-001
  dock_sn: "SN_DOCK_EXAMPLE"
  username: "${env:DJI_MQTT_USERNAME}"
  password: "${env:DJI_MQTT_PASSWORD}"
  ca_file: null
  cert_file: null
  key_file: null
  subscribe_patterns:
    - "thing/product/+/+"
    - "thing/product/+/property/+"
    - "thing/product/+/drc/+"
    - "sys/product/+/+"
  deny_topics:
    - exact: "thing/product/SN_DOCK_EXAMPLE/firmware_upgrade"
    - regex: "thing/product/.+/token.*"

storage:
  root: ./recordings
  enable_raw_firehose: false
  flush_max_records: 1000
  flush_interval_ms: 200
  queue_max_size: 10000
  rotate_max_bytes: 104857600
  rotate_max_records: 1000000

video:
  enabled: true
  source_url_field: "osd.live_capacity.live_status[0].rtmp_url"
  source_url_override: null
  ffmpeg_extra_args: []

flight_detection:
  finalize_idle_seconds: 30
  # 规则字段支持 dot-path（如 "data.mode_code"），由 RuleEvaluator 逐层下钻。
  # mode_code 参考 DJI Cloud API M30/Dock 3 文档：
  #   0=standby/在地待机   1=preparing       2=ready
  #   3=manual flight      4=auto takeoff    5=wayline 执行
  #   6=panoramic          7=active track    8=ADS-B 规避
  #   9=auto RTH           10=auto landing   11=forced landing
  #   12=三桨落地          13=upgrading      14=disconnected
  rules:
    start:
      # 主信号：飞行器进入任何非 standby 状态即视为飞行开始
      - source: drone_osd
        field: "data.mode_code"
        not_equals: 0
      # 兜底 A：dock 下发起飞/航线/RTH 类 services 也立刻进入 recording
      # （避免飞行器 osd 还没到达前漏掉前几条机场端消息）
      - source: dock_services
        field: "method"
        in: ["takeoff_to_point", "return_home", "fly_to_point",
             "wayline_prepare", "wayline_start", "drc_mode_enter"]
      # 兜底 B：dock_events 携带 flight_id 的飞行进度类消息
      - source: dock_events
        field: "method"
        in: ["return_home_info", "flighttask_progress",
             "wayline_status_update", "task_progress"]
    end:
      # 主信号：飞行器回到 standby（mode_code=0）持续 30s = 真正落地
      - source: drone_osd
        field: "data.mode_code"
        equals: 0
        sustain_seconds: 30
      # 兜底：机场报告 drone_in_dock=1（无人机已停泊）持续 30s
      - source: dock_osd
        field: "data.drone_in_dock"
        equals: 1
        sustain_seconds: 30
